{
  "name": "kandinsky-in-ui",
  "version": "0.1.0",
  "description": "A generative geometric-abstraction design system for UI, inspired by Wassily Kandinsky (Circles in a Circle). Seed-based, deterministic, framework core with a React adapter.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "predemo": "npm run build",
    "demo": "node demo/build-showcase.mjs",
    "demo:recipes": "node demo/render-recipes.mjs",
    "predemo:recipes": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react-dom": "^19",
    "typescript": "^5"
  },
  "keywords": [
    "design-system",
    "generative-art",
    "svg",
    "react",
    "kandinsky"
  ]
}
